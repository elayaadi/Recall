# Course materials — never committed. data/raw/ holds the corpus; what is in
# it and under what licence is recorded in data/CORPUS.md. Any other data/raw-*
# directory is a local working copy and is ignored by the same rule, so removing
# one from this file can never make it committable by accident.
data/raw/*
!data/raw/.gitkeep
data/raw-*/

# Generated indexes, embeddings, eval run outputs
data/chunks*.jsonl
data/index/
data/sample/*.pdf
index/
*.faiss
*.npy

# Local agent context — must never be committed
CLAUDE.local.md

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
.lavish/
